<?xml version="1.0" encoding="UTF-8"?>
<!--
  迁移自 mytool 的 tmux 项目（原 wsw_tmux）。

  本清单只声明"应用去找的"链接；$HOME/.wtool/wtool-work-dir/links/<id> 是引擎 install 时
  自动创建、指向整个项目目录的"稳定地址"，不需要在这里声明。
  bin/ 下的状态脚本就是通过它被 tmux.conf 引用的
  （tmux.conf 里写 $HOME/.wtool/wtool-work-dir/links/terminal/tmux/bin/*.sh）。

  注意：**项目身份就是它的路径 `terminal/tmux`**（ADR-0037 删掉了 id= 属性），
  它出现在三处：
    ~/.wtool/wtool-work-dir/links/<路径>  、  ~/.zshrc 的 wtool 块  、  tmux.conf 里的引用。
  身份**就是路径**（ADR-0037）：改目录 = 换身份，用 `wtool move` 改名，
  别自己 mv（旧路径那套账会留在原地，`wtool check` 会报出来）。
-->
<wtool schema="1" priority="50">

  <!-- 被 ~/.zshrc / ~/.bashrc 里的 wtool 块 source：两个 shell 各一份，
       内容等价（这里只有 export 和 alias，两边写法一样） -->
  <zshrc  src="env.zsh"/>
  <bashrc src="env.bash"/>

  <!-- home 是 $HOME 下的落点（写全，带 ~/）；wtool 是影子 HOME 里的那一跳，
       subproject 是项目里的来源文件。tmux 默认就读 ~/.tmux.conf -->
  <link home="~/.tmux.conf"
        wtool="~/.wtool/.tmux.conf"
        subproject="tmux.conf"/>

</wtool>
